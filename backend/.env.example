PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# SocialKit (https://socialkit.dev) — primary Instagram media provider,
# handles video/Reel downloads. Get an access key from your SocialKit
# dashboard. Server-side only, never sent to the frontend, never commit a
# real value here.
SOCIALKIT_ACCESS_KEY=

# Apify (https://apify.com) — fallback provider used only when SocialKit
# reports a post has no video (e.g. a photo post). Get a token from your
# Apify account settings. Server-side only, never commit a real value here.
APIFY_API_TOKEN=
